{
  "name": "seatroute-api",
  "version": "1.0.0",
  "description": "REST API for the SeatRoute Android app: intercity fixed-seat limo booking for one operator, manual transfer proofs, parcels",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "docs": "node scripts/gen-docs.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "mongodb-memory-server": "^9.5.0",
    "supertest": "^7.0.0"
  }
}
