NODE_ENV=development
PORT=4000
# Same Atlas cluster as the other apps, one database per app: seatroute
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/seatroute?retryWrites=true&w=majority
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CORS_ORIGINS=
# The operator's timezone: local trip times, "today", reports
TIMEZONE=Asia/Ho_Chi_Minh

# Public URL of this API (reset email links, web deletion page)
PUBLIC_BASE_URL=

# Default admin created by `npm run db:init` when there is no admin (random password printed once)
DEFAULT_ADMIN_EMAIL=

# App version gate (GET /v1/health, header X-App-Version -> 426 when older than MIN_APP_VERSION)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Sessions (feature 8): access token 2h, refresh token sliding 3h, absolute session 12h (same as RoomKeep)
ACCESS_TOKEN_MINUTES=120
REFRESH_IDLE_MINUTES=180
SESSION_MAX_HOURS=12
MAX_SESSIONS_PER_ACCOUNT=10

# Password reset email (feature 7). When SMTP_HOST is empty, outside production the code is returned as devToken.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SeatRoute <no-reply@example.com>
RESET_CODE_MINUTES=30

# Recurring trips are generated this many days ahead
SERIES_WINDOW_DAYS=45

# Optional: when set, /v1/jobs/run requires "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it)
CRON_SECRET=

# Privacy page owner/contact
PRIVACY_OWNER=
PRIVACY_EMAIL=

# Per-IP limits. RATE_LIMIT=off disables them.
RATE_READ_PER_MIN=180
RATE_WRITE_PER_MIN=60
RATE_AUTH_PER_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
